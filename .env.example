# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
# -----------------------------------------------------------------------------

# EmailJS (Contact form) — https://www.emailjs.com/
# These are safe to expose to the client (that's how EmailJS works).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# GitHub API (optional). Without a token the public API still works but is
# rate-limited to 60 requests/hour per IP. A classic token with NO scopes
# (public data only) raises this to 5,000/hour. Keep this server-side only.
GITHUB_TOKEN=
